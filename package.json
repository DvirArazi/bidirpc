{
  "name": "bidirpc-repo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/client",
    "packages/server",
    "packages/codegen",
    "examples/basic/client",
    "examples/basic/server"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:basic": "npm run build -w basic-example-client && npm run build -w basic-example-server",
    "start:basic": "npm run start -w basic-example-server"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
